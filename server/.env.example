PORT=5000

# Chuỗi kết nối PostgreSQL (Trên Render dùng Internal Database URL)
DATABASE_URL="postgresql://postgres:12345@localhost:5432/cvconnect?schema=public"

# Khóa bí mật ký JWT Token
JWT_SECRET="cvconnect_super_secret_key_2026"

# URL của Frontend trên Vercel (không cần dấu / ở cuối, có thể ngăn cách nhiều URL bằng dấu phẩy)
FRONTEND_URL="http://localhost:5173"

# Tự động khởi tạo dữ liệu mẫu (Admin, Công ty, Việc làm, CV) ở lần chạy đầu tiên khi DB trống
AUTO_SEED="true"

# (Tùy chọn) Cấu hình Cloudinary để lưu file CV PDF trên đám mây (nếu bỏ trống hệ thống tự lưu dự phòng vào PostgreSQL)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# (Tùy chọn 1 - Khuyên dùng trên Render Free vì dùng HTTPS cổng 443) Gửi Email qua Brevo API hoặc Resend API
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# (Tùy chọn 2 - Dùng cho Local hoặc Render gói trả phí) Cấu hình Gmail SMTP
EMAIL_USER="youremail@gmail.com"
EMAIL_PASS="your-app-password"
